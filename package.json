{
    "name": "Ministry-Services-Guide",
    "private": true,
    "workspaces": [
        "client",
        "server",
        "shared"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=client",
        "dev:server": "npm run dev --workspace=server",
        "dev:client": "npm run dev --workspace=client",
        "build": "npm run build --workspace=client && npm run build --workspace=server"
    },
    "allowScripts": {
        "es5-ext@0.10.64": true,
        "esbuild": true,
        "prisma": true,
        "@prisma/client": true,
        "@prisma/engines": true
    },
    "overrides": {
        "esbuild": "^0.25.0"
    }
}
