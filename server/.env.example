# Copy this file to .env and replace YOUR_PASSWORD with the SQL Server login password.
DATABASE_URL="sqlserver://localhost\SQLEXPRESS;database=MOH;user=Admin;password={YOUR_PASSWORD};encrypt=true;trustServerCertificate=true"

# Then run from the repository root:
# npm run db:generate --workspace=server
# npm run db:push --workspace=server
# npm run db:crud --workspace=server
# db:push creates the PrismaCrudSmokeTest table in MOH.
