generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model PrismaCrudSmokeTest {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(100)
  details   String   @db.NVarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               Int                   @id @default(autoincrement())
  email            String                @unique @db.NVarChar(320)
  name             String                @db.NVarChar(200)
  passwordHash     String                @db.NVarChar(255)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  roles            UserRole[]
  serviceDivisions UserServiceDivision[]
  pageAuditEntries PageAudit[]

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.NVarChar(50)
  createdAt DateTime   @default(now())
  users     UserRole[]

  @@map("roles")
}

model ServiceDivision {
  id          Int                   @id @default(autoincrement())
  name        String                @unique @db.NVarChar(150)
  /// Arabic name; the converter's --category must match it (or the English name)
  nameAr      String?               @db.NVarChar(150)
  order       Int                   @default(0)
  /// Category colour: the colour of its services' labels (hex, e.g. #074169)
  color       String?               @db.NVarChar(20)
  createdAt   DateTime              @default(now())
  users       UserServiceDivision[]
  services    Service[]
  labelColors DivisionLabelColor[]

  @@map("service_divisions")
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserServiceDivision {
  userId            Int
  serviceDivisionId Int
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceDivision   ServiceDivision @relation(fields: [serviceDivisionId], references: [id], onDelete: Cascade)

  @@id([userId, serviceDivisionId])
  @@index([serviceDivisionId])
  @@map("user_service_divisions")
}

model Page {
  id           Int         @id @default(autoincrement())
  slug         String      @unique @db.NVarChar(200)
  title        String      @db.NVarChar(300)
  /// Serialized JSON text. SQL Server's Prisma connector does not support a native Json scalar.
  content      String      @db.NVarChar(Max)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditEntries PageAudit[]

  @@map("pages")
}

model PageAudit {
  id         BigInt   @id @default(autoincrement())
  pageId     Int?
  userId     Int?
  action     String   @db.NVarChar(50)
  /// Optional serialized JSON snapshots of the page before and after the change.
  beforeData String?  @db.NVarChar(Max)
  afterData  String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  page       Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  changedBy  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([userId, createdAt])
  @@map("pages_audit")
}

model Service {
  id                Int              @id @default(autoincrement())
  serviceDivisionId Int
  serviceDivision   ServiceDivision  @relation(fields: [serviceDivisionId], references: [id])
  /// From "اسم الخدمة"
  name              String           @db.NVarChar(400)
  /// The Word file it came from
  sourceFile        String?          @db.NVarChar(400)
  order             Int              @default(0)
  /// The documentation, one row per section
  sections          ServiceSection[]
  /// A service can have several flowcharts
  flowcharts        Flowchart[]
  images            ServiceImage[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([serviceDivisionId, name])
}

/// One part of a service's documentation (وصف الخدمة, الرسوم, ...).
model ServiceSection {
  id        Int     @id @default(autoincrement())
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// description, requirements, documents, channel, department, workflow,
  /// duration, fees (or intro for text before the first section title)
  key       String  @db.VarChar(40)
  /// The title as written in the Word file
  label     String? @db.NVarChar(400)
  html      String  @db.NVarChar(Max)
  order     Int     @default(0)

  @@unique([serviceId, key])
}

/// A flowchart of a service, as JSON text (SQL Server has no JSON column in
/// Prisma). A service can have several. push.js never changes them.
model Flowchart {
  id         Int      @id @default(autoincrement())
  serviceId  Int
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Shown above the diagram (the Excel sheet name by default)
  title      String?  @db.NVarChar(400)
  /// Order among the service's flowcharts
  order      Int      @default(0)
  /// The Excel file it came from; pushing that file again replaces only these
  sourceFile String?  @db.NVarChar(400)
  json       String   @db.NVarChar(Max)
  updatedAt  DateTime @updatedAt

  @@index([serviceId])
}

/// A picture page of a service, uploaded in the editor (file kept in server/uploads).
model ServiceImage {
  id        Int      @id @default(autoincrement())
  serviceId Int
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Path under the server's /uploads, e.g. uploads/123-456.png
  imagePath String   @db.NVarChar(400)
  /// contain | cover
  imageFit  String   @default("contain") @db.VarChar(20)
  caption   String?  @db.NVarChar(400)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([serviceId])
}

/// The shared labels of the documentation (وصف الخدمة, الرسوم, ...): their name and
/// order apply to every service. `key` is ServiceSection.key.
model SectionLabel {
  id     Int                  @id @default(autoincrement())
  key    String               @unique @db.VarChar(40)
  name   String               @db.NVarChar(200)
  order  Int                  @default(0)
  colors DivisionLabelColor[]
}

/// A category's own colour for one label (overrides ServiceDivision.color).
model DivisionLabelColor {
  id                Int             @id @default(autoincrement())
  serviceDivisionId Int
  serviceDivision   ServiceDivision @relation(fields: [serviceDivisionId], references: [id], onDelete: Cascade)
  labelId           Int
  label             SectionLabel    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  color             String          @db.NVarChar(20)

  @@unique([serviceDivisionId, labelId])
}
